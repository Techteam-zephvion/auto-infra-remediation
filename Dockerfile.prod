# Production Dockerfile for AutoInfraRemediation
FROM python:3.13-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r autoremediation && useradd -r -g autoremediation -u 1001 autoremediation

# Set work directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.prod.txt .
RUN pip install --no-cache-dir -r requirements.prod.txt

# Copy full project (imports use service.webhook.* path hierarchy)
COPY . .

# Set PYTHONPATH so "from service.webhook.X import Y" resolves
ENV PYTHONPATH=/app

# Create necessary directories
RUN mkdir -p /app/logs && \
    chown -R autoremediation:autoremediation /app

# Switch to non-root user
USER autoremediation

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Expose port
EXPOSE 8001

# Default: run the API. Worker overrides this CMD in docker-compose.
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8001", "--app-dir", "/app/service/webhook"]