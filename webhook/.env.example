# ── Ollama LLM Configuration ──────────────────────────────────────────────────
# Base URL for Ollama service (local or remote)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for analysis and safety validation
OLLAMA_MODEL=llama3.1:8b

# Timeout for LLM calls in seconds (default: 30)
OLLAMA_TIMEOUT=30

# ── PostgreSQL Audit Trail ────────────────────────────────────────────────────
# Database connection string for audit events
# Leave blank to use in-memory fallback
# SECURITY: Never commit actual credentials to git!
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/auto_remediation

# ── OpenTelemetry Observability ───────────────────────────────────────────────
# Enable/disable distributed tracing (true/false)
OTEL_ENABLED=true

# OTLP HTTP endpoint for traces (Jaeger, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name for trace identification
OTEL_SERVICE_NAME=auto-infra-remediation

# ── Temporal Workflow Orchestration ───────────────────────────────────────────
# Temporal server address (gRPC)
TEMPORAL_HOST=localhost:7233

# Temporal namespace (default: "default")
TEMPORAL_NAMESPACE=default

# Task queue name for workers
TEMPORAL_TASK_QUEUE=auto-remediation-queue

# Enable/disable Temporal (true/false) - falls back to direct execution if disabled
TEMPORAL_ENABLED=true

# ── Alert Tuning and Notifications ────────────────────────────────────────────
# Enable/disable notifications (true/false)
NOTIFICATIONS_ENABLED=true

# Slack incoming webhook URL for alert notifications
# Get this from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty integration key for incident creation
# Get this from: PagerDuty Service > Integrations > Events API v2
PAGERDUTY_INTEGRATION_KEY=YOUR_PAGERDUTY_INTEGRATION_KEY

# PagerDuty API key for incident management (optional)
PAGERDUTY_API_KEY=YOUR_PAGERDUTY_API_KEY

# ── LLM Response Caching ──────────────────────────────────────────────────────
# Enable/disable LLM response caching (true/false)
LLM_CACHE_ENABLED=true

# Redis connection URL for LLM cache
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (default: 3600 = 1 hour)
# Set to 0 to disable cache expiration
# LLM_CACHE_TTL=3600

# ── Security Notes ────────────────────────────────────────────────────────────
# 1. Copy this file to .env and fill in actual values
# 2. Never commit .env to version control (.gitignore should exclude it)
# 3. Use strong passwords for DATABASE_URL (minimum 16 characters)
# 4. For production, use HashiCorp Vault or similar secret management
# 5. Rotate credentials regularly (recommended: every 90 days)
# 6. Avoid default credentials like postgres/postgres in production
