# ── Ollama LLM Configuration ──────────────────────────────────────────────────
# Base URL for Ollama service (local or remote)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for analysis and safety validation
OLLAMA_MODEL=llama3.1:8b

# Timeout for LLM calls in seconds (default: 30)
OLLAMA_TIMEOUT=30

# ── PostgreSQL Audit Trail ────────────────────────────────────────────────────
# Database connection string for audit events
# Leave blank to use in-memory fallback
# SECURITY: Never commit actual credentials to git!
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/auto_remediation

# ── OpenTelemetry Observability ───────────────────────────────────────────────
# Enable/disable distributed tracing (true/false)
OTEL_ENABLED=true

# OTLP HTTP endpoint for traces (Jaeger, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name for trace identification
OTEL_SERVICE_NAME=auto-infra-remediation

# ── Temporal Workflow Orchestration ───────────────────────────────────────────
# Temporal server address (gRPC)
TEMPORAL_HOST=localhost:7233

# Temporal namespace (default: "default")
TEMPORAL_NAMESPACE=default

# Task queue name for workers
TEMPORAL_TASK_QUEUE=auto-remediation-queue

# Enable/disable Temporal (true/false) - falls back to direct execution if disabled
TEMPORAL_ENABLED=true

# ── HashiCorp Vault Secret Management ─────────────────────────────────────────
# Vault server address
VAULT_ADDR=http://localhost:8200

# Vault token for authentication  
# For dev: Use root token from docker logs (docker-compose logs vault | grep "Root Token")
# For prod: Use proper authentication method (AppRole, Kubernetes, etc.)
VAULT_TOKEN=dev-root-token

# Enable/disable Vault integration (true/false)
# Falls back to environment variables if disabled or unavailable
VAULT_ENABLED=true

# Vault KV v2 mount path (default: secret)
VAULT_MOUNT_PATH=secret

# ── Alert Tuning and Notifications ────────────────────────────────────────────
# Enable/disable notifications (true/false)
NOTIFICATIONS_ENABLED=true

# Slack incoming webhook URL for alert notifications
# Get this from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/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L

# PagerDuty integration key for incident creation
# Get this from: PagerDuty Service > Integrations > Events API v2
PAGERDUTY_INTEGRATION_KEY=5de6d84de9144d04c068318e2d85c35b

# PagerDuty API key for incident management (optional)
PAGERDUTY_API_KEY=YOUR_PAGERDUTY_API_KEY

# ── LLM Response Caching ──────────────────────────────────────────────────────
# Enable/disable LLM response caching (true/false)
LLM_CACHE_ENABLED=true

# Redis connection URL for LLM cache
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (default: 3600 = 1 hour)
# Set to 0 to disable cache expiration
# LLM_CACHE_TTL=3600

# ── Multi-Model LLM Fallback ──────────────────────────────────────────────────
# OpenAI API key for GPT-4 fallback (tertiary model in chain)  
# Primary: qwen2.5:3b (local, fast) → Secondary: llama3.1:8b (local, accurate)  
# → Tertiary: GPT-4 (cloud, highest quality)
# Get API key from: https://platform.openai.com/api-keys
# Leave blank to disable GPT-4 fallback (only use local Ollama models)
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# ── RAG Knowledge Base ────────────────────────────────────────────────────────
# Enable/disable knowledge base for RAG-enhanced prompts (true/false)
KNOWLEDGE_BASE_ENABLED=true

# ChromaDB HTTP API URL
CHROMADB_URL=http://localhost:8000

# Embedding model for semantic search (HuggingFace model name)
# Default: all-MiniLM-L6-v2 (384 dimensions, fast, good quality)
# Alternatives: all-mpnet-base-v2 (768 dim, higher quality, slower)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Device for embedding generation ('cpu' or 'cuda')
EMBEDDING_DEVICE=cpu

# ── Security Notes ────────────────────────────────────────────────────────────
# 1. Copy this file to .env and fill in actual values:
#    cp .env.example .env
#
# 2. Never commit .env to version control (.gitignore excludes it)
#
# 3. Use strong passwords for DATABASE_URL (minimum 16 characters)
#    Avoid default credentials like postgres/postgres in production
#
# 4. Get Vault root token from docker logs after first start:
#    docker-compose logs vault | grep "Root Token"
#
# 5. Get Slack webhook URL from:
#    https://api.slack.com/messaging/webhooks
#
# 6. Get PagerDuty integration key from:
#    PagerDuty Service > Integrations > Events API v2
#
# 7. For production:
#    - Use HashiCorp Vault for all secrets (not .env files)
#    - Rotate credentials regularly (every 90 days recommended)
#    - Use managed services (Cloud SQL, ElastiCache, etc.)
#    - Enable audit logging on all services
#
# 8. Optional: Leave OPENAI_API_KEY blank to only use local Ollama models
#    (Primary: qwen2.5:3b, Secondary: llama3.1:8b, no cloud fallback)
